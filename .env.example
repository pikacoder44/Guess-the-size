# -----------------------------------------------------------------------------
# Frontend Client Environment Variables (.env.example)
# Copy this file to .env.local to configure your local development environment.
# -----------------------------------------------------------------------------

# Supabase Project Configuration (Used for avatar storage and Supabase auth)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# Google OAuth 2.0 Web Client ID
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Optional backend API URL (Leave blank to use Vite's dev proxy to http://localhost:3001)
VITE_API_URL=
