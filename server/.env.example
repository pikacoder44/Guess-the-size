# -----------------------------------------------------------------------------
# Backend API Environment Variables (server/.env.example)
# Copy this file to server/.env to configure your local backend server.
# -----------------------------------------------------------------------------

# Server Configuration
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Database Configuration (PostgreSQL / Supabase)
# Notice: If left unset or set to placeholder values, the server will
# automatically use an in-memory SQL store for local development.
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_SSL=true

# JWT Authentication
JWT_SECRET=your-secure-jwt-secret-key-at-least-32-characters
JWT_EXPIRES_IN=7d

# Google OAuth 2.0 Credentials (for server-side token verification)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
CLIENT_ID=your-google-client-id.apps.googleusercontent.com
CLIENT_SECRET=your-google-client-secret
